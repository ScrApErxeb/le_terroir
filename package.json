      "public/**/*",
      "node_modules/sqlite3/lib/binding/**/*"
    ]
  },
  "dependencies": {
    "express": "^4.18.4",
    "sqlite3": "^5.1.6",
    "sqlite": "^4.1.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
