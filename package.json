{
  "name": "cave-app",
  "version": "1.0.0",
  "description": "Application de gestion de cave, facturation, paiements, comptabilite.",
  "bin": "server.js",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/le_terroir.exe"
  },
  "pkg": {
